PORT=3001
NODE_ENV=development

# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (puerto 6543)
# o "Direct connection". Reemplazá [YOUR-PASSWORD] por la contraseña de la base.
# NUNCA subas este archivo con valores reales a GitHub (.env está en .gitignore).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Opcional: certificado CA de Supabase para validar el SSL (Database > SSL Configuration)
DB_SSL_CA=

# Generá uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción debe tener al menos 32 caracteres.
JWT_SECRET=cambia_esto_por_un_texto_largo_y_secreto
JWT_EXPIRES=2h

# Dominios permitidos para usar la API, separados por coma. OBLIGATORIO en producción.
# Ej: https://pokecard.vercel.app
CORS_ORIGIN=http://localhost:5173

# Si la API está detrás de un proxy (Render, Railway, Nginx...): 1
TRUST_PROXY=
