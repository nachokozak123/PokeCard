# Copiá este archivo como ".env" y completá los valores.

# Cadena de conexión de Supabase:
# Supabase → botón "Connect" (arriba) → "Session pooler" → copiá la URI y poné tu contraseña.
DATABASE_URL=postgresql://postgres.quwavigermvvkbmuqpud:pokecard12345678910@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Texto largo y aleatorio (mínimo 32 caracteres) para firmar las sesiones.
# Generalo con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=3001

# "production" al publicar: activa cookies seguras (solo HTTPS).
NODE_ENV=development

# Poné "false" solo si usás un PostgreSQL local sin SSL (con Supabase dejalo vacío).
DB_SSL=
